NODE_ENV=development
PORT=8080
OSINT_BASE_PATH=/osint
OSINT_DATABASE_URL=postgres://studerria_osint:replace-me@127.0.0.1:5434/studerria_osint
OSINT_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
OSINT_GITHUB_TOKEN=
OSINT_MAX_GRAPH_NODES=500
OSINT_GRAPH_WARNING_NODES=300
OSINT_MAX_GRAPH_RELATIONSHIPS=2000
OSINT_MAX_IMPORT_BYTES=5242880
OSINT_MAX_IMPORT_RECORDS=5000
OSINT_COLLECTOR_TIMEOUT_MS=15000
OSINT_WEB_MAX_PAGES=5
OSINT_WEB_MAX_RESPONSE_BYTES=2097152
OSINT_RETENTION_DAYS=90
OSINT_API_RATE_LIMIT_PER_MINUTE=120
OSINT_ASSERTION_MAX_AGE_SECONDS=60
OSINT_RUN_CONCURRENCY=1
