NODE_ENV=development
PORT=8080
OSINT_BASE_PATH=/osint
OSINT_DATABASE_URL=postgres://studerria_osint:replace-me@127.0.0.1:5434/studerria_osint
OSINT_ADMIN_USERNAME=osint-admin
OSINT_ADMIN_PASSWORD=replace-with-a-long-random-password
OSINT_SESSION_SECRET=replace-with-at-least-32-random-bytes
OSINT_ADMIN_COOKIE_SECURE=false
OSINT_ADMIN_SESSION_TTL_SECONDS=28800
OSINT_GITHUB_TOKEN=
# Optional third-party provider. Do not use an Instagram password or session cookie.
OSINT_INSTAGRAM_APIFY_TOKEN=
OSINT_INSTAGRAM_APIFY_ACTOR_ID=zaver.api~instagram-followers-scraper
OSINT_INSTAGRAM_MAX_CONNECTIONS=200
OSINT_INSTAGRAM_PROVIDER_TIMEOUT_MS=120000
OSINT_INSTAGRAM_MAX_COST_USD=1
OSINT_MAX_GRAPH_NODES=500
OSINT_GRAPH_WARNING_NODES=300
OSINT_MAX_GRAPH_RELATIONSHIPS=2000
OSINT_MAX_IMPORT_BYTES=5242880
OSINT_MAX_IMPORT_RECORDS=5000
OSINT_COLLECTOR_TIMEOUT_MS=15000
OSINT_WEB_MAX_PAGES=5
OSINT_WEB_MAX_RESPONSE_BYTES=2097152
OSINT_RETENTION_DAYS=90
OSINT_API_RATE_LIMIT_PER_MINUTE=120
OSINT_RUN_CONCURRENCY=1
