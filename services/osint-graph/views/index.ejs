<!doctype html>
<html lang="uk" data-theme="dark">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>OSINT · Карта розслідування</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Ctext y=%2750%27 font-size=%2755%27%3E◎%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="/osint/assets/workspace.css?v=1.13.33">
<script src="/osint/vendor/cytoscape.min.js" defer></script><script src="/osint/assets/uk.js?v=1.13.33" defer></script><script src="/osint/assets/workspace.js?v=1.13.33" defer></script>
</head>
<body data-csrf="<%= csrfToken %>" data-actor="<%= actor.label %>">
<header class="top"><a href="/osint" class="brand"><span>◎</span> OSINT <small>Карта розслідування</small></a><span class="operator"><%= actor.label %></span><button id="logout">Вийти</button></header>
<div class="shell">
<aside class="sidebar" id="sidebarPanel" aria-label="Список і пошук">
<div class="section-label">РОЗСЛІДУВАННЯ <button id="newCase" aria-label="Створити розслідування">＋</button><button class="mobile-only" data-close-panel="sidebar" aria-label="Закрити список">×</button></div>
<select id="cases" aria-label="Розслідування"><option value="">Оберіть розслідування</option></select>
<label class="search-label"><input type="search" id="search" placeholder="Назва, адреса або нотатка" aria-label="Пошук у розслідуванні"></label>
<label class="checkrow"><input id="onlyMatches" type="checkbox">Лише збіги на графі</label>
<button id="toggleFilters" aria-expanded="false" aria-controls="filtersPanel">Фільтри <span id="filterCount">0</span></button>
<div id="filtersPanel" hidden>
<label>Тип сутності<select id="typeFilter"><option value="">Усі типи</option></select></label>
<label>Тип зв’язку<select id="relationFilter"><option value="">Усі зв’язки</option></select></label>
<label>Статус<select id="statusFilter"><option value="">Усі статуси</option><option value="FACT">Факт · FACT</option><option value="INFERENCE">Аналітичний висновок · INFERENCE</option><option value="HYPOTHESIS">Гіпотеза · HYPOTHESIS</option></select></label>
<label>Докази<select id="evidenceFilter"><option value="">Усі</option><option value="yes">З доказами</option><option value="no">Без доказів</option></select></label>
<label>Джерело<select id="sourceFilter"><option value="">Усі джерела</option></select></label>
<label>Створено від<input type="date" id="dateFilter"></label><button id="resetFilters">Скинути всі</button></div>
<nav class="panel-tabs" aria-label="Розділи списку"><button data-side="entities" class="active">Сутності</button><button data-side="layers">Шари</button><button data-side="leads">Зачіпки</button></nav>
<section data-side-panel="entities"><div class="section-label">СУТНОСТІ <button data-action="entity" aria-label="Додати сутність">＋</button></div><div id="entityList" class="entity-list"></div></section>
<section data-side-panel="layers" hidden><div class="section-label">ШАРИ <button data-action="layer" aria-label="Створити шар">＋</button></div><div id="layers"></div></section>
<section data-side-panel="leads" hidden><div class="section-label">ЗАЧІПКИ <button data-action="lead" aria-label="Додати зачіпку">＋</button></div><div id="leadList"></div></section>
</aside>
<main><div class="case-head"><div><p class="eyebrow">РОБОЧИЙ ПРОСТІР</p><h1 id="caseTitle">Карта розслідування</h1></div><button id="toggleInspector" aria-expanded="true" aria-controls="inspectorPanel">Деталі</button></div><div id="stats" class="stats"></div>
<div class="tools"><button id="toggleSidebar" class="mobile-only" aria-expanded="false" aria-controls="sidebarPanel">Список</button><button class="primary" data-action="entity">＋ Додати сутність</button><button id="connectMode" aria-pressed="false">↗ З’єднати</button><div id="selectionTools" hidden><span id="selectionCount"></span><button id="groupSelected">Створити групу</button><button id="mergeSelected">Об’єднати дублікати</button></div><span class="spacer"></span><span id="saveStatus" role="status">Збережено</span><button id="retryLayout" hidden>Повторити</button>
<details class="more-menu"><summary>Ще</summary><div><button data-action="source">Додати доказ</button><button data-action="lead">Додати зачіпку</button><button data-action="note">Додати нотатку</button><button id="import">Імпорт</button><button id="export">Експорт</button><button id="caseMenu">Налаштування розслідування</button></div></details></div>
<div id="connectHint" role="status" hidden><span></span><button id="cancelConnect">Скасувати</button><button id="connectForm">Обрати зі списку</button></div>
<nav id="views" aria-label="Представлення"><button class="active" data-view="Graph">Граф</button><button data-view="Table">Таблиця</button><button data-view="Timeline">Хронологія</button><button data-view="Evidence">Докази</button><button data-view="Leads">Зачіпки</button><button data-view="Notes">Нотатки</button><button data-view="Analysis">Аналіз</button></nav>
<section class="canvas-area"><div id="graph" aria-label="Граф розслідування"></div><div id="viewContent" hidden></div><div id="empty"><span>◎</span><h2>Почніть із першої сутності</h2><p>Створіть розслідування й додайте сутність на карту.</p><button class="primary" id="emptyCreate">Створити розслідування</button></div><div id="graphFooter"><span title="Факт · FACT">── Факт · FACT</span><span title="Аналітичний висновок · INFERENCE">┄ Висновок · INFERENCE</span><span title="Гіпотеза · HYPOTHESIS">··· Гіпотеза · HYPOTHESIS</span><button id="fit">Вписати</button><button id="layout">Упорядкувати</button></div></section></main>
<aside class="inspector" id="inspectorPanel" aria-label="Деталі вибраного об’єкта"><header class="panel-header"><strong>Деталі</strong><button data-close-panel="inspector" aria-label="Згорнути деталі">×</button></header><nav class="panel-tabs" aria-label="Розділи деталей"><button data-inspector-tab="overview" class="active">Огляд</button><button data-inspector-tab="evidence">Докази</button><button data-inspector-tab="notes">Нотатки</button><button data-inspector-tab="connections">Зв’язки</button></nav><div id="inspector"><div class="placeholder"><h2>Деталі та докази</h2><p>Оберіть сутність або зв’язок на графі.</p></div></div></aside></div>
<dialog id="editor" aria-labelledby="editorTitle"><form id="editorForm"><header><h2 id="editorTitle"></h2><button type="button" id="closeEditor" aria-label="Закрити форму">×</button></header><div id="fields"></div><p id="formError" role="alert"></p><footer><button type="button" id="cancelEditor">Скасувати</button><button class="primary" type="submit">Зберегти</button></footer></form></dialog>
<dialog id="confirmDialog" aria-labelledby="confirmTitle"><h2 id="confirmTitle"></h2><p id="confirmText"></p><footer><button id="confirmNo">Повернутися</button><button id="confirmYes" class="danger">Підтвердити</button></footer></dialog>
<dialog id="imageDialog" aria-label="Перегляд доказу"><button id="closeImage" aria-label="Закрити зображення">×</button><img id="evidenceImage" alt="Зображення доказу"><p id="imageError" hidden>Перегляд недоступний. Скористайтеся завантаженням файла.</p></dialog>
<div id="context" hidden></div><div id="toast" role="status" hidden></div>
</body></html>
