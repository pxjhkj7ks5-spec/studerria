<!doctype html>
<html lang="uk" data-theme="dark">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>OSINT · Investigation Graph</title><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Ctext y=%2750%27 font-size=%2755%27%3E◎%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/osint/assets/workspace.css?v=1.13.32"><script src="/osint/vendor/cytoscape.min.js" defer></script><script src="/osint/assets/workspace.js?v=1.13.32" defer></script></head>
<body data-csrf="<%= csrfToken %>" data-actor="<%= actor.label %>">
<header class="top"><a href="/osint" class="brand"><span>◎</span> OSINT <small>Investigation Graph</small></a><span class="operator"><%= actor.label %></span><button id="logout">Вийти</button></header>
<div class="shell">
<aside class="sidebar"><div class="section-label">РОЗСЛІДУВАННЯ <button id="newCase" title="Створити розслідування">＋</button></div><select id="cases" aria-label="Розслідування"><option value="">Оберіть розслідування</option></select><input type="search" id="search" placeholder="Пошук у розслідуванні" aria-label="Пошук"><div class="section-label">СУТНОСТІ <button data-action="entity">＋</button></div><div id="entityList" class="entity-list"></div>
<details open><summary>Фільтри</summary><label>Тип сутності<select id="typeFilter"><option value="">Усі типи</option></select></label><label>Тип зв’язку<select id="relationFilter"><option value="">Усі зв’язки</option></select></label><label>Статус<select id="statusFilter"><option value="">Усі статуси</option><option>FACT</option><option>INFERENCE</option><option>HYPOTHESIS</option></select></label><label>Докази<select id="evidenceFilter"><option value="">Усі</option><option value="yes">З доказами</option><option value="no">Без доказів</option></select></label><label>Джерело<select id="sourceFilter"><option value="">Усі джерела</option></select></label><label>Створено від<input type="date" id="dateFilter"></label></details>
<div class="section-label">ШАРИ <button data-action="layer">＋</button></div><div id="layers"></div><div class="section-label">ЗАЧІПКИ <button data-action="lead">＋</button></div><div id="leadList"></div><footer class="sidefoot">Ручний workspace <span>●</span></footer></aside>
<main><div class="case-head"><div><p class="eyebrow">INVESTIGATION WORKSPACE</p><h1 id="caseTitle">Карта розслідування</h1></div><button id="caseMenu" aria-label="Редагувати розслідування">Налаштування</button></div><div id="stats" class="stats"></div><div class="tools"><button class="primary" data-action="entity">＋ Сутність</button><button data-action="relationship">↗ Зв’язок</button><button data-action="source">＋ Доказ</button><button data-action="lead">＋ Зачіпка</button><span class="spacer"></span><button id="groupSelected">Група</button><button id="mergeSelected">Об’єднати</button><button id="import">Імпорт</button><button id="export">Експорт</button></div><nav id="views" aria-label="Представлення"><button class="active" data-view="Graph">Graph</button><button data-view="Table">Table</button><button data-view="Timeline">Timeline</button><button data-view="Evidence">Evidence</button><button data-view="Leads">Leads</button><button data-view="Notes">Notes</button><button data-view="Analysis">Analysis</button></nav>
<section class="canvas-area"><div id="graph" aria-label="Граф розслідування"></div><div id="viewContent" hidden></div><div id="empty"><span>◎</span><h2>Почніть із першої зачіпки</h2><p>Створіть розслідування й додайте сутність на карту.</p><button class="primary" id="emptyCreate">Створити розслідування</button></div><div id="graphFooter"><span>── FACT</span><span>┄ INFERENCE</span><span>··· HYPOTHESIS</span><small>Подвійний клік — сутність · Shift + drag — зв’язок</small><button id="fit">Вписати</button><button id="layout">Упорядкувати</button></div></section></main>
<aside id="inspector" class="inspector"><div class="placeholder"><span>↗</span><h2>Деталі та докази</h2><p>Оберіть сутність або зв’язок на графі.</p></div></aside></div>
<dialog id="editor"><form id="editorForm"><header><h2 id="editorTitle"></h2><button type="button" id="closeEditor" aria-label="Закрити">×</button></header><div id="fields"></div><p id="formError" role="alert"></p><footer><button type="button" id="cancelEditor">Скасувати</button><button class="primary" type="submit">Зберегти</button></footer></form></dialog><div id="context" hidden></div><div id="toast" role="status" hidden></div>
</body></html>
