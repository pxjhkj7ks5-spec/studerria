generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  draft
  published
}

enum TelegramImportStatus {
  imported
  failed
}

enum OrderStatus {
  new
  confirmed
  processing
  shipped
  completed
  cancelled
}

enum DeliveryMethod {
  branch
  parcel_locker
  courier
}

enum PaymentMethod {
  cash_on_delivery
  transfer
}

enum NotificationStatus {
  pending
  sent
  skipped
  failed
}

model SiteSetting {
  id            Int      @id
  heroTitle     String
  heroSubtitle  String
  supportTitle  String
  supportBody   String
  materialsNote String
  leadTimeNote  String
  deliveryNote  String
  paymentNote   String
  telegramUrl   String
  contactNote   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String    @default("")
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                        Int                 @id @default(autoincrement())
  title                     String
  slug                      String              @unique
  categoryId                Int
  shortDescription          String              @default("")
  fullDescription           String              @default("")
  status                    ProductStatus       @default(draft)
  isFeatured                Boolean             @default(false)
  basePrice                 Int?
  priceFrom                 Boolean             @default(false)
  leadTime                  String              @default("")
  materialNote              String              @default("")
  deliveryNote              String              @default("")
  paymentNote               String              @default("")
  sortOrder                 Int                 @default(0)
  sourceTelegramChannel     String?
  sourceTelegramMessageId   Int?
  sourceTelegramUrl         String              @default("")
  sourceTelegramPublishedAt DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  category                  Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants                  ProductVariant[]
  images                    ProductImage[]
  telegramImport            TelegramPostImport?
  orderItems                OrderItem[]

  @@unique([sourceTelegramChannel, sourceTelegramMessageId])
}

model Order {
  id                    Int                @id @default(autoincrement())
  publicId              String             @unique
  status                OrderStatus        @default(new)
  firstName             String
  lastName              String
  comment               String             @default("")
  phone                 String
  telegramContact       String
  cityName              String
  cityRef               String             @default("")
  deliveryMethod        DeliveryMethod
  deliveryDestination   String
  destinationRef        String             @default("")
  courierAddress        String             @default("")
  paymentMethod         PaymentMethod
  total                 Int
  currency              String             @default("UAH")
  notificationStatus    NotificationStatus @default(pending)
  notificationError     String             @default("")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  items                 OrderItem[]

  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int
  productId      Int?
  productSlug    String
  productTitle   String
  productUrl     String
  variantId      Int?
  variantLabel   String   @default("")
  quantity       Int
  unitPrice      Int
  totalPrice     Int
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model ProductVariant {
  id          Int      @id @default(autoincrement())
  productId   Int
  label       String
  price       Int
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  fileName  String
  urlPath   String
  alt       String   @default("")
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model TelegramChannelSync {
  channel           String    @id
  lastSeenMessageId Int       @default(0)
  lastCheckedAt     DateTime?
  lastSuccessfulAt  DateTime?
  lastError         String    @default("")
  importedCount     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model TelegramPostImport {
  id          Int                  @id @default(autoincrement())
  channel     String
  messageId   Int
  messageUrl  String
  contentHash String
  title       String               @default("")
  status      TelegramImportStatus
  error       String               @default("")
  productId   Int?                 @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  product     Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([channel, messageId])
  @@index([status, updatedAt])
}

model AnalyticsEvent {
  id          Int      @id @default(autoincrement())
  name        String
  path        String   @default("")
  location    String   @default("")
  intent      String   @default("")
  productSlug String   @default("")
  category    String   @default("")
  sessionId   String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([productSlug, createdAt])
}
