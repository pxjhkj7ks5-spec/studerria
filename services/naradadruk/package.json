{
  "name": "naradadruk",
  "version": "0.1.00",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "catalog:build": "node scripts/build-telegram-catalog.mjs",
    "catalog:import": "tsx prisma/import-catalog.ts",
    "catalog:refresh": "npm run catalog:scrape && npm run catalog:build",
    "catalog:scrape": "node scripts/scrape-telegram-channel.mjs naradaprint catalog/telegram-posts.json --download-images",
    "catalog:sync": "tsx scripts/telegram-catalog-worker.ts --once",
    "catalog:sync:full": "tsx scripts/telegram-catalog-worker.ts --once --full",
    "makerworld:bot": "tsx scripts/makerworld-bot-worker.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "6.19.3",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "maplibre-gl": "^5.13.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.15"
    },
    "protocol-buffers-schema": "3.6.1"
  }
}
