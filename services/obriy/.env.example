# KMA: add OBRIY_* values to docker/local/.env. Existing POSTGRES_* stays unchanged.
# server-update.sh obriy generates the four local security keys once, without printing them.
OBRIY_PUBLIC_URL=https://studerria.com/obriy
OBRIY_BASE_PATH=/obriy
OBRIY_ENCRYPTION_KEY=
# Shared entry key; each person then uses their own account.
OBRIY_ADMIN_TOKEN=
OBRIY_METRICS_TOKEN=
OBRIY_TELEGRAM_WEBHOOK_SECRET=
# New bot: https://t.me/BotFather -> /newbot. Suggested name: Obriy / Обрій.
# A public username must be available and end in bot; do not reuse another service's token.
OBRIY_TELEGRAM_BOT_TOKEN=
OBRIY_TELEGRAM_BOT_USERNAME=
# Polling works behind the existing reverse proxy; no webhook registration required.
OBRIY_TELEGRAM_MODE=polling
# Request a personal token: https://alerts.in.ua/api-request
OBRIY_ALERTS_TOKEN=
# NEPTUN does not need a token. These URLs are server-only; no zone data is appended.
OBRIY_NEPTUN_WS_URL=wss://neptun.in.ua/api/v1/stream
OBRIY_NEPTUN_REST_URL=https://neptun.in.ua/api/v1/threats
OBRIY_ALERTS_URL=https://api.alerts.in.ua/v1/alerts/active.json
OBRIY_NEPTUN_POLL_MS=15000
OBRIY_HEARTBEAT_MS=60000
OBRIY_ALERTS_POLL_MS=15000
OBRIY_DEFAULT_RADIUS_KM=10
OBRIY_RETENTION_DAYS=30
OBRIY_RAW_RETENTION_HOURS=24
OBRIY_SESSION_HOURS=12
# Unidentified integration: deliberately disabled even when an identifier is present.
OBRIY_AIRSIGMA_SOURCE_IDENTIFIER=
# Local standalone development only (Compose supplies its own database connection):
NODE_ENV=development
PORT=8080
OBRIY_DB_HOST=127.0.0.1
OBRIY_DB_PORT=5432
OBRIY_DB_NAME=obriy
OBRIY_DB_USER=obriy
OBRIY_DB_PASSWORD=
